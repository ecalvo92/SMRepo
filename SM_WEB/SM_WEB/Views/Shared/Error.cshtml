@{
    ViewData["Title"] = "Error";
}
<div class="container-fluid py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-6">
            <div class="card text-center shadow-sm">
                <div class="card-body p-4 p-md-5">
                    
                    <i class="bi bi-exclamation-triangle-fill text-danger display-3"></i>
                    
                    <h1 class="h3 mt-3">¡Ups! Algo salió mal</h1>
                    
                    <p class="text-muted mb-4">Ocurrió un error inesperado al procesar su solicitud. Por favor intente nuevamente o regrese al inicio.</p>
                    
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a href="~/" class="btn btn-primary"><i class="bi bi-house-fill"></i> Ir al inicio</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
